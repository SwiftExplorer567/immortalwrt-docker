#!/bin/sh

dev=$(uci -q get network.lan.device || echo eth0)

stop_qos() {
	tc qdisc del dev $dev root 2>/dev/null
	tc qdisc del dev $dev ingress 2>/dev/null
	tc qdisc del dev ${dev}-ifb root 2>/dev/null
	ip link del dev ${dev}-ifb 2>/dev/null
}

start_qos() {
	local dl=$1
	local up=$2
	
	# 1. Egress on eth0 (Download shaping)
	tc qdisc add dev $dev root handle 1: htb default 1
	tc class add dev $dev parent 1: classid 1:1 htb rate 1000mbit
	# Global default download class for LAN clients (prio 10)
	tc class add dev $dev parent 1:1 classid 1:2 htb rate ${dl}mbit ceil ${dl}mbit
	tc filter add dev $dev parent 1:0 protocol ip prio 10 u32 match ip dst 192.168.0.0/16 flowid 1:2
	tc filter add dev $dev parent 1:0 protocol ip prio 10 u32 match ip dst 10.0.0.0/8 flowid 1:2
	tc filter add dev $dev parent 1:0 protocol ip prio 10 u32 match ip dst 172.16.0.0/12 flowid 1:2
	
	# 2. Ingress on eth0 redirected to IFB (Upload shaping)
	ip link add dev ${dev}-ifb name ${dev}-ifb type ifb 2>/dev/null || true
	ip link set dev ${dev}-ifb up
	
	tc qdisc add dev ${dev}-ifb root handle 1: htb default 1
	tc class add dev ${dev}-ifb parent 1: classid 1:1 htb rate 1000mbit
	# Global default upload class for LAN clients (prio 10)
	tc class add dev ${dev}-ifb parent 1:1 classid 1:2 htb rate ${up}mbit ceil ${up}mbit
	tc filter add dev ${dev}-ifb parent 1:0 protocol ip prio 10 u32 match ip src 192.168.0.0/16 flowid 1:2
	tc filter add dev ${dev}-ifb parent 1:0 protocol ip prio 10 u32 match ip src 10.0.0.0/8 flowid 1:2
	tc filter add dev ${dev}-ifb parent 1:0 protocol ip prio 10 u32 match ip src 172.16.0.0/12 flowid 1:2
	
	# Redirect eth0 ingress to IFB
	tc qdisc add dev $dev ingress
	tc filter add dev $dev parent ffff: protocol ip u32 match u32 0 0 flowid 1:1 action mirred egress redirect dev ${dev}-ifb
}

case "$1" in
	"stop")
		stop_qos
	;;
	"start")
		stop_qos
		start_qos $2 $3
	;;
	"add")
		ip="$2"
		dl="$3"
		up="$4"
		
		cnt=$(tc class show dev $dev | wc -l)
		
		# Specific device download override (prio 1)
		tc class add dev $dev parent 1:1 classid 1:1$cnt htb rate ${dl}mbit ceil ${dl}mbit
		tc filter add dev $dev parent 1:0 protocol ip prio 1 u32 match ip dst $ip flowid 1:1$cnt
		
		# Specific device upload override (prio 1)
		tc class add dev ${dev}-ifb parent 1:1 classid 1:1$cnt htb rate ${up}mbit ceil ${up}mbit
		tc filter add dev ${dev}-ifb parent 1:0 protocol ip prio 1 u32 match ip src $ip flowid 1:1$cnt
	;;
	*)
		echo "Usage: $0 {start|stop|add}"
	;;
esac
