#!/bin/sh
# Custom initial configuration script for ImmortalWrt Docker Gateway
# Executed once on first boot

# Timezone & System
uci set system.@system[0].hostname='ImmortalWrt'
uci set system.@system[0].zonename='Europe/Istanbul'
uci set system.@system[0].timezone='<+03>-3'
uci commit system

# LuCI UI & Language defaults
uci set luci.main.lang='auto'
uci set luci.main.mediaurlbase='/luci-static/argon'
uci set luci.themes.Argon='/luci-static/argon'
uci commit luci

# Network LAN default (Macvlan Gateway Mode)
# Only apply default IP if network.lan.ipaddr is not already configured (preserves persistent volume configs)
CURRENT_LAN_IP=$(uci -q get network.lan.ipaddr || true)
if [ -z "$CURRENT_LAN_IP" ]; then
    uci set network.lan=interface
    uci set network.lan.proto='static'
    uci set network.lan.device='eth0'
    uci set network.lan.ipaddr='192.168.1.2'
    uci set network.lan.netmask='255.255.255.0'
    uci set network.lan.gateway='192.168.1.1'
    uci set network.lan.dns='1.1.1.1 8.8.8.8'
    uci commit network
fi

# Firewall defaults for Bypass Gateway
uci set firewall.@defaults[0].forward='ACCEPT'
uci set firewall.@zone[0].forward='ACCEPT'
uci set firewall.@zone[0].masq='1'
uci commit firewall

# OpenClash directories, permissions & Access Control defaults
mkdir -p /etc/openclash/core /etc/openclash/config /etc/openclash/backup
chmod -R 755 /etc/openclash
# To exclude specific devices from OpenClash proxy (bypass), uncomment and set your IPs/MACs:
# if [ -f /etc/config/openclash ]; then
#     uci -q set openclash.config.lan_ac_mode='0'
#     uci -q delete openclash.config.lan_ac_black_ips
#     uci -q delete openclash.config.lan_ac_black_macs
#     uci -q add_list openclash.config.lan_ac_black_ips='192.168.1.100'
#     uci -q add_list openclash.config.lan_ac_black_macs='AA:BB:CC:DD:EE:FF'
#     uci commit openclash
# fi

# Disable unconditional dnsmasq DNS hijack so blacklisted devices resolve DNS cleanly
if [ -f /etc/config/dhcp ]; then
    uci -q set dhcp.@dnsmasq[0].dns_redirect='0'
    uci commit dhcp
fi

# TurboACC default setup (if available)
if [ -f /etc/config/turboacc ]; then
    uci set turboacc.config.bbr_cca='1'
    uci set turboacc.config.full_cone_nat='1'
    uci commit turboacc
fi

# TTYD Web Terminal default setup
if [ -f /etc/config/ttyd ]; then
    uci set ttyd.@ttyd[0].interface='eth0'
    uci commit ttyd
fi

# Allow SSH / Dropbear on LAN
uci set dropbear.@dropbear[0].Interface='lan'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci commit dropbear

# uhttpd Web Server Defaults (HTTP Port 80)
if [ -f /etc/config/uhttpd ]; then
    uci -q delete uhttpd.main.listen_http
    uci add_list uhttpd.main.listen_http='0.0.0.0:80'
    uci add_list uhttpd.main.listen_http='[::]:80'
    uci -q set uhttpd.main.redirect_https='0'
    uci commit uhttpd
    /etc/init.d/uhttpd enable 2>/dev/null || true
fi

# Bandwidth & Monitoring Services setup
if [ -f /etc/init.d/nlbwmon ]; then
    /etc/init.d/nlbwmon enable 2>/dev/null || true
fi
if [ -f /etc/init.d/vnstat ]; then
    uci -q delete vnstat.@vnstat[0].interface
    uci add_list vnstat.@vnstat[0].interface='eth0'
    uci add_list vnstat.@vnstat[0].interface='utun'
    uci commit vnstat
    /etc/init.d/vnstat enable 2>/dev/null || true
fi
if [ -f /etc/init.d/collectd ]; then
    uci -q set luci_statistics.collectd_interface.enable='1'
    uci -q add_list luci_statistics.collectd_interface.Interfaces='eth0'
    uci -q set luci_statistics.collectd_ping.enable='1'
    uci -q add_list luci_statistics.collectd_ping.Hosts='1.1.1.1'
    uci -q add_list luci_statistics.collectd_ping.Hosts='8.8.8.8'
    uci -q set luci_statistics.collectd_cpu.enable='1'
    uci -q set luci_statistics.collectd_memory.enable='1'
    uci -q set luci_statistics.collectd_load.enable='1'
    uci commit luci_statistics
    /etc/init.d/collectd enable 2>/dev/null || true
fi
if [ -f /etc/init.d/netdata ]; then
    /etc/init.d/netdata enable 2>/dev/null || true
fi

# SQM Smart Queue Management (Disabled by default on single-arm gateway to prevent LAN throttling)
if [ -f /etc/init.d/sqm ]; then
    uci -q delete sqm.eth1
    uci -q delete sqm.eth0
    uci set sqm.eth0=queue
    uci set sqm.eth0.enabled='0'
    uci set sqm.eth0.interface='eth0'
    uci set sqm.eth0.download='0'
    uci set sqm.eth0.upload='0'
    uci set sqm.eth0.qdisc='cake'
    uci set sqm.eth0.script='piece_of_cake.qos'
    uci commit sqm
fi

# Custom Commands Defaults
if [ -f /etc/config/luci_commands ]; then
    touch /etc/config/luci_commands
    uci add luci_commands command
    uci set luci_commands.@command[-1].name='Flush DNS & Web Cache'
    uci set luci_commands.@command[-1].command='rm -rf /tmp/luci-* && /etc/init.d/dnsmasq restart && /etc/init.d/rpcd restart && echo Cache Cleared!'
    uci add luci_commands command
    uci set luci_commands.@command[-1].name='Restart OpenClash'
    uci set luci_commands.@command[-1].command='/etc/init.d/openclash restart && echo OpenClash Restarted!'
    uci add luci_commands command
    uci set luci_commands.@command[-1].name='Network & Connection Info'
    uci set luci_commands.@command[-1].command='echo "Active Connections: $(cat /proc/net/nf_conntrack | wc -l)" && echo "TCP Congestion Control: $(sysctl -n net.ipv4.tcp_congestion_control)"'
    uci commit luci_commands
fi

# Patch EQOS to support container interfaces (eth0) dynamically instead of hardcoded br-lan
if [ -f /usr/sbin/eqos ]; then
    sed -i 's/dev=br-lan/dev=$(uci -q get network.lan.device || echo eth0)/g' /usr/sbin/eqos
fi

exit 0



